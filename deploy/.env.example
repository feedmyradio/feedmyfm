# Copy to deploy/.env and fill in. `docker compose` reads .env from the
# directory it is invoked in, so run compose from deploy/ (or pass
# --env-file deploy/.env).

# Password for the feedmyfm-rx daemon's password-gated config/stations
# write endpoints on status.port -- what backs the webui /admin editor
# (deploy/compose.rx.yml). Leave blank to disable those endpoints (503);
# GET / and GET /api/stations/active work regardless. Also required
# (non-blank) whenever config.yml's status.host is non-loopback, e.g. the
# split SDR-host/listener-host topology -- see README "Deployment
# topologies".
#
# webui's own compose.web.yml reads this too: with decode.listener_gated
# on and a non-loopback status.host, webui's relay needs the same value
# to authenticate its POST /active pushes -- set it identically on both
# hosts in a split topology.
#
# ChangeMe is a placeholder, not a real default -- set your own before
# this is reachable from anywhere but loopback.
FEEDMYFM_RX_ADMIN_PASSWORD=ChangeMe

# Split topology only (feedmyfm-rx running on a different host than
# webui): point webui at that host's status port.
# RX_URL=http://<rx-host>:8082

# Override where webui's logos volume mounts from -- see
# deploy/logos/README.md. Only needed if your real logo set lives outside
# this repo (e.g. a private per-deployment location).
# LOGOS_DIR=/path/to/your/logos
